{
    "name": "hyperlocal-backend",
    "version": "1.0.0",
    "description": "Production-grade Express TypeScript backend",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon",
        "dev:worker": "nodemon --exec ts-node src/worker.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "start:worker": "node dist/worker.js",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "express",
        "typescript",
        "backend"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@stream-io/node-sdk": "^0.7.55",
        "bullmq": "^5.76.2",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "helmet": "^7.1.0",
        "http-status-codes": "^2.3.0",
        "ioredis": "^5.10.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "razorpay": "^2.9.6",
        "socket.io": "^4.8.3",
        "stream-chat": "^9.41.1",
        "winston": "^3.11.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.10.6",
        "@types/pg": "^8.20.0",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "eslint": "^8.56.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}