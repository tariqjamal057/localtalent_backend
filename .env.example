# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hyperlocal

# Redis
REDIS_URL=redis://localhost:6379
QUEUE_REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Payment (Razorpay)
TAX_PERCENTAGE=18
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Stream (Video Call)
STREAM_CALL_API_KEY=xxx
STREAM_CALL_API_SECRET=xxx

# Stream (Chat)
STREAM_CHAT_API_KEY=xxx
STREAM_CHAT_API_SECRET=xxx

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET_NAME=hyperlocal-dev

# i18n
SUPPORTED_LOCALES=en,hi,ta

# Firebase (FCM push notifications)
# Path to the Firebase Admin SDK service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./sayyti-7ecd2-firebase-adminsdk-fbsvc-29956bd04c.json
